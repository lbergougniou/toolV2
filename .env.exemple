# Configuration de l'API ViaDialog
VIAD_API_USERNAME=votre_nom_utilisateur
VIAD_API_PASSWORD=votre_mot_de_passe
VIAD_API_COMPANY=votre_compagnie
VIAD_API_GRANT_TYPE=password
VIAD_API_SLUG=votre_slug
VIAD_API_BASE_URL=https://viaflow-dashboard.viadialog.com

# Configuration de l'environnement
APP_ENV=development
APP_DEBUG=true

# Configuration de la base de données locale
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=viadialog
DB_USERNAME=root
DB_PASSWORD=

# Credentials API Scorimmo v2 (SDK scorimmo-php)
# SCORIMMO_EMAIL doit être une adresse email (identifiant du compte API v2)
SCORIMMO_EMAIL=votre_email@scorimmo.com
SCORIMMO_PASSWORD=votre_mot_de_passe
SCORIMMO_WEBHOOK_SECRET=votre-secret-webhook
# URL de l'instance Scorimmo (pp.scorimmo.com pour la préprod, pro.scorimmo.com pour la prod)
SCORIMMO_URL=https://pro.scorimmo.com

# Configuration de la base de données Scorimmo (via tunnel SSH)
SCORIMMO_DB_HOST=127.0.0.1
SCORIMMO_DB_PORT=13306
SCORIMMO_DB_NAME=votre_base
SCORIMMO_DB_USER=votre_utilisateur
SCORIMMO_DB_PASSWORD=votre_mot_de_passe

# Configuration SSH pour le tunnel
SSH_HOST=votre_serveur_ssh
SSH_USER=votre_utilisateur_ssh
SSH_KEY=~/.ssh/votre_cle
SSH_REMOTE_HOST=votre_serveur_mysql
SSH_REMOTE_PORT=3306
# Webhook de réception des emails (MTA Oxeva) de l'instance cible de l'outil Email_Inbound_Replay.php
# Identifiants basic auth éventuels dans l'URL (https://user:pass@pp.scorimmo.com/email/inbound)
# Le secret est l'INBOUND_EMAIL_WEBHOOK_SECRET de l'instance cible ; son INBOUND_EMAIL_WEBHOOK_ALLOWED_IPS doit inclure l'IP du poste
INBOUND_TARGET_URL=https://pp.scorimmo.com/email/inbound
INBOUND_TARGET_SECRET=
# Domaine des traceurs de l'instance cible, imposé au destinataire de chaque rejeu (webhook comme SMTP), partie
# locale conservée : mail-pp.scorimmo.com en PPD (le MTA route aussi vers la PPD selon ce domaine), vide = inchangé
INBOUND_RECIPIENT_DOMAIN=mail-pp.scorimmo.com
# Cible « Local » de l'outil (test des parsers) : webhook de la webapp locale, défaut https://localhost:8000/email/inbound (symfony serve redirige le HTTP en 307)
# Le secret doit être l'INBOUND_EMAIL_WEBHOOK_SECRET du .env.local de la webapp (vide côté webapp = 500)
INBOUND_LOCAL_URL=https://localhost:8000/email/inbound
INBOUND_LOCAL_SECRET=
# Domaine des traceurs de la base locale (SUFFIX_EMAIL de la webapp), vide = inchangé
INBOUND_LOCAL_RECIPIENT_DOMAIN=mail.scorimmo.com
# Emails reçus par l'API, rejoués en webhook direct sur POST /api/email (parsers Api*) : compte API v1 (ApiUser,
# /api/login_check) de chaque cible, vide = rejeu de ces emails refusé. Le PDV du destinataire doit être sous le PDV du compte (sinon 403).
# Les parsers Api* comparent le destinataire exact (ex : bienneuf@mail.scorimmo.com) : en PPD (mail-pp) ils ne matchent pas
INBOUND_TARGET_API_USERNAME=
INBOUND_TARGET_API_PASSWORD=
INBOUND_LOCAL_API_USERNAME=
INBOUND_LOCAL_API_PASSWORD=
# Transport SMTP de l'outil Email_Inbound_Replay.php (vide = désactivé) : remise par swaks au MTA Oxeva, qui
# appelle lui-même le webhook de l'instance associée au domaine destinataire (pas INBOUND_TARGET_URL).
# Le port 25 sortant étant bloqué par les box, swaks passe par un tunnel SSH (INBOUND_SMTP_SSH : alias ~/.ssh/config
# ou user@hôte ; vide = connexion directe) ; HOST/PORT sont alors vus depuis ce serveur. Il faut un serveur qui joint
# le MTA : backup (hors Oxeva). Les serveurs Oxeva (ppd, relais s2262) ne le joignent pas, les mails y restent en file.
INBOUND_SMTP_HOST=158.255.65.253
INBOUND_SMTP_PORT=25
INBOUND_SMTP_SSH=backup
# Port local du tunnel ; refusé s'il est déjà pris par un autre processus (ancien tunnel vers une autre destination)
INBOUND_SMTP_TUNNEL_PORT=12525
# Chemin de swaks si absent du PATH du serveur web (brew install swaks)
SWAKS_BIN=
